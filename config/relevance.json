{
  "_comment": "ACNABIN relevance rules. All patterns are case-insensitive regular expressions matched on word boundaries. 'phrases' are matched against the listing title/description; 'document_phrases' are also matched against tender document text (keep these specific, because tender documents contain boilerplate such as 'audited financial statements of the bidder').",
  "ifrs9": {
    "strong": [
      "IFRS[\\s-]*0?9",
      "আইএফআরএস[\\s-]*(?:৯|9)",
      "expected credit loss(?:es)?",
      "এক্সপেক্টেড ক্রেডিট লস",
      "ECL[\\s-]+(?:model(?:s|ling|ing)?|methodology|framework|solution|system|software|engine|tool|calculation|computation|implementation|validation|review|assessment|consultan(?:cy|t))",
      "ইসিএল মডেল",
      "(?:expected )?credit loss model(?:s|ling|ing)?",
      "impairment of financial (?:instruments|assets)",
      "financial instruments? impairment"
    ],
    "contextual": [
      {
        "term": "ECL",
        "context": [
          "model",
          "methodolog",
          "IFRS",
          "impairment",
          "provision",
          "stag(?:e|ing)",
          "probability of default",
          "PD",
          "LGD",
          "validation",
          "credit loss"
        ]
      },
      {
        "term": "(?:probability of default|loss given default|exposure at default|PD/LGD|LGD|SICR|significant increase in credit risk)",
        "context": [
          "IFRS",
          "ECL",
          "impairment",
          "expected (?:credit )?loss",
          "staging"
        ]
      },
      {
        "term": "impairment (?:model(?:s|ling|ing)?|methodology|assessment)",
        "context": [
          "IFRS",
          "ECL",
          "expected (?:credit )?loss",
          "financial instrument",
          "loan",
          "credit"
        ]
      },
      {
        "term": "credit risk model(?:s|ling|ing)?",
        "context": [
          "IFRS",
          "ECL",
          "impairment",
          "expected (?:credit )?loss",
          "provision"
        ]
      }
    ],
    "context_window_chars": 200
  },
  "categories": [
