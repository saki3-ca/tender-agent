# Supabase (worker writes with the service role key; dashboard reads with the anon key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Crawler identification and run budget
CRAWLER_CONTACT_EMAIL=tenders@acnabin.com
RUN_TIME_BUDGET_MINUTES=14

# Optional: Telegram alert for each newly found Priority tender
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: one email per run listing newly found Priority tenders (Gmail: use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=person1@acnabin.com,person2@acnabin.com

# Dashboard address (used in alert links)
DASHBOARD_BASE_URL=https://acnabin-tenders.pages.dev
