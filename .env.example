# Supabase Database & Auth (Free tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Modes & Providers (Free tier)
# AI_MODE: off (rules only) | triage_only (rules + embeddings + Groq triage) | full (all stages)
AI_MODE=full

# Groq (Triage & Stage 4 Review)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_TRIAGE_MODEL=llama-3.3-70b-versatile
GROQ_REVIEW_MODEL=mixtral-8x7b-32768
GROQ_DAILY_CALL_LIMIT=1000

# Cloudflare Workers AI (Multilingual Embeddings)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-m3
CLOUDFLARE_DAILY_CALL_LIMIT=5000

# Gemini (Full Extraction)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CALL_LIMIT=500
AI_MAX_INPUT_CHARS=12000
SEMANTIC_THRESHOLD=0.78

# Search Discovery API
SEARCH_PROVIDER=google
SEARCH_API_KEY=your_search_api_key
SEARCH_ENGINE_ID=your_cse_id
SEARCH_DAILY_QUERY_LIMIT=100

# Crawler Config
CRAWLER_CONTACT_EMAIL=tender-crawler@acnabin-procurement.com
RUN_TIME_BUDGET_MINUTES=4

# Notifications & Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@acnabin.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_TO=tender-committee@acnabin.com

# Dashboard
DASHBOARD_BASE_URL=https://tender-agent-d01.pages.dev
